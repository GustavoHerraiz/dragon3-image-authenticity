 * generar-veredicto.js
 * 
 * CÉLULA COMPUESTA - GENERADOR DE VEREDICTO FINAL
 * ================================================
 * 
 * VERSIÓN: 2.1.1
 * ESTADO: PRODUCCIÓN ✅
 * 
 * 
 * PROPÓSITO:
 * ----------
 * Recibe los resultados de TODAS las células de análisis y genera un veredicto
 * final mediante consenso ponderado. Incluye TODOS los resultados en la salida
 * para que el adaptador pueda procesar los datos de cada célula.
 * 
 * NUEVO: DETECCIÓN DE SELLO DRAGON3/MBH
 * --------------------------------------
 * Si la imagen contiene metadatos que verifican su autenticidad mediante
 * el sello Dragon3, la confianza se incrementa automáticamente.
 * 
 * CAMPOS DEL SELLO DRAGON3:
 * - Software: "Dragon3 V22 Mentalist Core" (o similar)
 * - Copyright: "Protected by Dragon3" o "Dragon3"
 * - Source: "Dragon3 Verificado"
 * - Artist: (autor real)
 * - description: contiene "DRAGON3_ID:XXXXX"
 * 
 * 
 * FILOSOFÍA:
 * ----------
 * - KISS: Simple y directo
 * - Consenso ponderado (no democracia simple)
 * - Trazabilidad completa (correlationId, agenteId)
 * - Transparencia total (incluye TODOS los resultados)
 * 
 * 
 * @module generar-veredicto
 * @version 2.1.1
 * @author Dragon3 / Agent Embassy
 * @license MIT
 */

// ============================================================
//  CONSTANTES DEL SELLO DRAGON3
// ============================================================

const DRAGON3_SELLO = {
  // Palabras clave para detectar el sello Dragon3
  KEYWORDS: [
    'Dragon3',
    'dragon3',
    'DRAGON3',
    'Protected by Dragon3',
    'Dragon3 Verificado',
    'Dragon3 V22',
    'Mentalist Core',
  ],
  
  // Patrón para ID de Dragon3
  ID_PATTERN: /DRAGON3_ID:[A-Z0-9_]+/i,
  
  // Confianza adicional si se detecta el sello
  BONUS_CONFIANZA: 0.25, // +25% de confianza
  
  // Peso adicional en el veredicto
  BONUS_PESO: 0.2,
};

// ============================================================
//  FUNCIÓN PRINCIPAL
// ============================================================

export default async function generarVeredicto(entrada, contexto) {
  // ============================================================
  // 1. EXTRAER DATOS DE ENTRADA
  // ============================================================
  
  const payload = entrada.payload || {};
  const correlationId = entrada.correlationId || contexto?.correlationId || 'desconocido';
  const agenteId = entrada.agenteId || contexto?.agenteId || 'desconocido';
  const planConfig = entrada.planConfig || contexto?.planConfig || {};

  // ============================================================
  // 2. DETECTAR SELLO DRAGON3 EN METADATOS
  // ============================================================
  
  let selloDragon3Detectado = false;
  let dragon3Id = null;
  let dragon3Evidencias = [];
  let dragon3ConfianzaBonus = 0;
  
  // Buscar en los resultados de extraer-metadatos-exif
  const exifResultado = payload['extraer-metadatos-exif'];
  if (exifResultado && typeof exifResultado === 'object') {
    // Buscar en metadatosCompletos
    const metadatos = exifResultado.metadatosCompletos || exifResultado;
    
    // Campos a revisar
    const campos = [
      'Software', 'Copyright', 'Source', 'Artist', 
      'description', 'rights', 'title', 'ImageDescription',
      'Creator', 'creador', 'author'
    ];
    
    for (const campo of campos) {
      const valor = metadatos[campo];
      if (!valor) continue;
      
      const valorStr = typeof valor === 'string' ? valor : 
                       (valor.value ? valor.value : JSON.stringify(valor));
      
      // Buscar palabras clave Dragon3
      for (const keyword of DRAGON3_SELLO.KEYWORDS) {
        if (valorStr.includes(keyword)) {
          selloDragon3Detectado = true;
          dragon3Evidencias.push(`✅ Sello Dragon3 detectado en ${campo}: "${valorStr}"`);
        }
      }
      
      // Buscar ID Dragon3
      const match = valorStr.match(DRAGON3_SELLO.ID_PATTERN);
      if (match) {
        dragon3Id = match[0];
        dragon3Evidencias.push(`✅ ID Dragon3 encontrado: ${dragon3Id}`);
        selloDragon3Detectado = true;
      }
    }
  }
  
  // Si se detectó el sello, aplicar bonus
  if (selloDragon3Detectado) {
    dragon3ConfianzaBonus = DRAGON3_SELLO.BONUS_CONFIANZA;
  }

  // ============================================================
  // 3. RECOPILAR RESULTADOS DE TODAS LAS CÉLULAS
  // ============================================================
  
  const resultados = [];
  
  for (const [celulaId, resultado] of Object.entries(payload)) {
    if (!resultado || typeof resultado !== 'object') continue;
    
    const esIA = resultado.esIA !== undefined ? resultado.esIA : null;
    const confianza = typeof resultado.confianza === 'number' ? resultado.confianza : null;
    const explicacion = resultado.explicacion || '';
    const evidencias = Array.isArray(resultado.evidencias) ? resultado.evidencias : [];
    const peso = typeof resultado.peso === 'number' ? resultado.peso : 1.0;
    
    if (esIA === null || confianza === null) continue;
    
    resultados.push({
      celulaId,
      esIA,
      confianza,
      explicacion,
      evidencias,
      peso,
    });
  }

  // ============================================================
  // 4. VALIDAR QUE HAYA RESULTADOS
  // ============================================================
  
  if (resultados.length === 0) {
    return {
      exito: true,
      resultado: {
        esIA: false,
        confianza: 0,
        explicacion: 'No se recibieron resultados de análisis suficientes para emitir un veredicto.',
        detalles: {
          error: 'Sin datos',
          correlationId,
          agenteId,
          planConfig,
          selloDragon3: { detectado: false },
          todosLosResultados: payload,
        },
      },
      metricas: { tiempoMs: 1 },
    };
  }

  // ============================================================
  // 5. CALCULAR VOTOS Y CONFIANZA
  // ============================================================
  
  let votosIA = 0;
  let votosHumano = 0;
  let sumaConfianzaIA = 0;
  let sumaPesosIA = 0;
  let sumaPesosHumano = 0;

  for (const r of resultados) {
    // Aplicar bonus de confianza si hay sello Dragon3 y la célula vota Humano
    let confianzaAjustada = r.confianza;
    let pesoAjustado = r.peso;
    
    if (selloDragon3Detectado && !r.esIA) {
      // Incrementar confianza de células que votan humano
      confianzaAjustada = Math.min(r.confianza + dragon3ConfianzaBonus, 1);
      // Incrementar peso ligeramente
      pesoAjustado = r.peso + DRAGON3_SELLO.BONUS_PESO;
    }
    
    if (r.esIA) {
      votosIA++;
      sumaConfianzaIA += confianzaAjustada * pesoAjustado;
      sumaPesosIA += pesoAjustado;
    } else {
      votosHumano++;
      sumaPesosHumano += pesoAjustado;
    }
  }

  const confianzaIA = sumaPesosIA > 0 ? sumaConfianzaIA / sumaPesosIA : 0;

  // ============================================================
  // 6. DECISIÓN FINAL POR MAYORÍA PONDERADA
  // ============================================================
  
  let esIAFinal = false;
  let decisionTexto = '';

  if (sumaPesosIA > sumaPesosHumano) {
    esIAFinal = true;
    decisionTexto = 'IA (mayoría ponderada)';
  } else if (sumaPesosHumano > sumaPesosIA) {
    esIAFinal = false;
    decisionTexto = 'Humano (mayoría ponderada)';
  } else {
    esIAFinal = confianzaIA > 0.5;
    decisionTexto = esIAFinal
      ? 'IA (empate, confianza > 0.5)'
      : 'Humano (empate, confianza <= 0.5)';
  }

  // ============================================================
  // 7. CALCULAR CONFIANZA GLOBAL
  // ============================================================
  
  let confianzaGlobal = esIAFinal ? confianzaIA : (1 - confianzaIA);
  confianzaGlobal = Math.min(Math.max(confianzaGlobal, 0), 1);
  
  // Aplicar bonus de confianza si el veredicto es Humano y hay sello Dragon3
  if (!esIAFinal && selloDragon3Detectado) {
    confianzaGlobal = Math.min(confianzaGlobal + dragon3ConfianzaBonus, 1);
  }

  // ============================================================
// 8. GENERAR EXPLICACIÓN ESTRUCTURADA
// ============================================================
  
  let explicacionGlobal = '';
  const partes = [];
  
  // --- 8.1. SELLO DRAGON3 (si está presente) ---
  if (selloDragon3Detectado) {
    const idTexto = dragon3Id ? ` (ID: ${dragon3Id})` : '';
    partes.push(`🔐 **IMAGEN VERIFICADA POR DRAGON3**${idTexto}`);
    partes.push('');
    partes.push('✅ **AUTENTICIDAD CONFIRMADA:**');
    
    // Eliminar duplicados de evidencias
    const evidenciasUnicas = [...new Set(dragon3Evidencias)];
    evidenciasUnicas.slice(0, 3).forEach(e => {
      partes.push(`   ${e}`);
    });
    partes.push(`   ✅ Confianza aumentada +${(DRAGON3_SELLO.BONUS_CONFIANZA * 100).toFixed(0)}%`);
    partes.push('');
  }
  
  // --- 8.2. ORIGEN (de EXIF) ---
  if (exifResultado && exifResultado.exif) {
    const exif = exifResultado.exif;
    const make = exif.Make || 'Desconocida';
    const model = exif.Model || '';
    const date = exif.DateTimeOriginal ? 
      new Date(exif.DateTimeOriginal).toLocaleDateString('es-ES', {
        day: '2-digit', month: '2-digit', year: 'numeric'
      }) : 'Desconocida';
    const artist = exif.Artist || 'Desconocido';
    
    partes.push('📸 **ORIGEN:**');
    partes.push(`   - Cámara: ${make} ${model}`);
    partes.push(`   - Fecha: ${date}`);
    partes.push(`   - Autor: ${artist}`);
    partes.push('');
  }
  
  // --- 8.3. VEREDICTO (CORREGIDO: usa esIAFinal en lugar de solo confianza) ---
  const decisionTextoFinal = esIAFinal ? 'IA' : 'HUMANO';
  const emoji = esIAFinal ? '⚠️' : '✅';
  
  partes.push(`${emoji} **VEREDICTO: ${decisionTextoFinal}** (${(confianzaGlobal * 100).toFixed(0)}% confianza)`);
  
  // --- 8.4. EVIDENCIAS CLAVE (sin duplicados) ---
  const evidenciasClave = resultados
    .filter(r => r.confianza > 20)
    .sort((a, b) => b.confianza - a.confianza)
    .slice(0, 4)
    .map(r => {
      // Limpiar la explicación de emojis y asteriscos
      let texto = r.explicacion
        .replace(/^[🔴🟢⚪✅❌⚠️]\s*/, '')
        .replace(/\*\*/g, '')
        .trim();
      
      // Si es muy larga, cortar
      if (texto.length > 100) {
        texto = texto.substring(0, 100) + '...';
      }
      return texto;
    })
    .filter((v, i, a) => a.indexOf(v) === i); // Eliminar duplicados
  
  if (evidenciasClave.length > 0) {
    partes.push('');
    partes.push('📊 **EVIDENCIAS CLAVE:**');
    evidenciasClave.forEach(e => {
      partes.push(`   - ${e}`);
    });
  }
  
  // Unir todas las partes
  explicacionGlobal = partes.join('\n');

  // ============================================================
  // 9. CONSTRUIR DETALLES COMPLETOS
  // ============================================================
  
  const detalles = {
    correlationId,
    agenteId,
    planConfig,
    totalCelulas: resultados.length,
    confianzaGlobal,
    votosIA,
    votosHumano,
    confianzaIA,
    decisionPor: decisionTexto,
    
    // 🔥 Información del sello Dragon3
    selloDragon3: {
      detectado: selloDragon3Detectado,
      id: dragon3Id,
      evidencias: dragon3Evidencias,
      bonusConfianza: dragon3ConfianzaBonus,
      confianzaAumentada: selloDragon3Detectado ? confianzaGlobal - (esIAFinal ? confianzaIA : (1 - confianzaIA)) : 0,
    },
    
    resultados: resultados.map(r => {
      const resultadoCompleto = payload[r.celulaId] || {};
      return {
        celula: r.celulaId,
        esIA: r.esIA,
        confianza: r.confianza,
        explicacion: r.explicacion,
        peso: r.peso,
        ...resultadoCompleto,
      };
    }),
    
    todosLosResultados: payload,
  };

  // ============================================================
  // 10. DEVOLVER RESULTADO
  // ============================================================
  
  return {
    exito: true,
    resultado: {
      esIA: esIAFinal,
      confianza: confianzaGlobal,
      explicacion: explicacionGlobal,
      detalles,
    },
    metricas: {
      tiempoMs: 2,
      totalCelulasProcesadas: resultados.length,
      selloDragon3Detectado: selloDragon3Detectado,
    },
  };
}

// ============================================================
//  EXPORTACIÓN PARA PRUEBAS UNITARIAS
// ============================================================

export async function testGenerarVeredicto(mockResultados) {
  return await generarVeredicto({ payload: mockResultados }, {});
}

