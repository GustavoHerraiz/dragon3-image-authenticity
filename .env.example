# Example environment configuration for Dragon3
# Copy this file to .env and fill in the required values.

# Public site or service entry point
APP_URL=https://www.bladecorporation.net

# Runtime environment
NODE_ENV=development

# API / service settings
DRAGON3_HOST=localhost
DRAGON3_PORT=3000
EMBASSY_PORT=3002
EMBASSY_URL=http://localhost:3002

# Runtime authentication and infrastructure
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
MONGO_URI=mongodb://localhost:27017/dragon
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-me
REDIS_DB=1

# Secrets and tokens
SECRET_KEY=replace-with-a-strong-secret
API_TOKEN=replace-with-token

# Database or storage (if used by your deployment)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dragon3
DB_USER=dragon3
DB_PASSWORD=replace-me

# File storage
UPLOAD_PATH=./shared/images
BACKUP_PATH=./shared/backups
TEMP_PATH=./temp

# Infra / logging
LOG_LEVEL=info
LOG_PATH=./logs

# ML runtime
PYTHON_BIN=./prod/Dragon3/engine/laboratorio/venv_ml/bin/python
ML_PREDICTOR_SCRIPT=./prod/Dragon3/engine/celulas/predictor_xgboost.py
DRAGON3_LAB_DIR=./prod/Dragon3/engine/laboratorio
ML_MODEL_PATH=./prod/Dragon3/engine/laboratorio/modelo_xgboost_25000_optimizado.pkl
