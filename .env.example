# Example environment configuration for Dragon3
# Copy this file to .env and fill in the required values.

# Public site or service entry point
APP_URL=https://www.bladecorporation.net

# Runtime environment
NODE_ENV=development

# API / service settings
DRAGON3_HOST=localhost
DRAGON3_PORT=3000

# Secrets and tokens
SECRET_KEY=replace-with-a-strong-secret
API_TOKEN=replace-with-token

# Database or storage (if used by your deployment)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dragon3
DB_USER=dragon3
DB_PASSWORD=replace-me

# File storage
UPLOAD_PATH=./shared/images
BACKUP_PATH=./shared/backups
TEMP_PATH=./temp

# Infra / logging
LOG_LEVEL=info
LOG_PATH=./logs
