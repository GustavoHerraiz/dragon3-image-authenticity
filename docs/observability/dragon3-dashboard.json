{
  "annotations": {"list": []},
  "editable": false,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Backend scrape",
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "up{job=\"dragon3-server\"}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "short", "mappings": [{"type": "value", "options": {"0": {"text": "DOWN"}, "1": {"text": "UP"}}}]}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "HTTP request rate",
      "gridPos": {"h": 8, "w": 12, "x": 6, "y": 0},
      "targets": [{"expr": "sum by (status_code) (rate(dragon3_http_requests_total[5m]))", "legendFormat": "HTTP {{status_code}}", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "reqps"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Latencia p95",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(dragon3_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "A"}],
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []}
    },
    {
      "type": "timeseries",
      "title": "Capacidad y análisis activos",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {"expr": "dragon3_active_analyses", "legendFormat": "activos", "refId": "A"},
        {"expr": "rate(dragon3_analysis_capacity_rejections_total[5m])", "legendFormat": "429/s", "refId": "B"}
      ],
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []}
    }
  ],
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["dragon3", "sre", "concurrency"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "title": "Dragon3 Enterprise Operations",
  "uid": "dragon3-enterprise",
  "version": 1
}
